# Copy to .env.local and restart Vite. Server-side only; never use VITE_ for keys.
# Create your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini
# Optional OpenRouter provider. Use a model ID from openrouter.ai/models.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash
# PREFERRED_AI_PROVIDER=openrouter
# OPENROUTER_MAX_TOKENS=2048
# Optional Gemini provider. Set PREFERRED_AI_PROVIDER=gemini to use it.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# PREFERRED_AI_PROVIDER=gemini
# Local SQL database created by the workforce importer (Node 22.13+).
# DATABASE_PATH=.local/workforce.sqlite
# Use JSON for the app until SQL is ready. Set to sql later with DATABASE_PATH.
WORKFORCE_DATA_SOURCE=json
