# Copy to .env.local and restart Vite. Server-side only; never use VITE_ for keys.
# Create your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini
# Local SQL database created by the workforce importer (Node 22.13+).
# DATABASE_PATH=.local/workforce.sqlite
