{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/index.mjs": { "maxDuration": 120 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?route=:path*" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
